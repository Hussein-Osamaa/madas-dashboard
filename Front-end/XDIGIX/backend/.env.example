# ============================================
# XDIGIX API - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection (replace <db_password> with your actual password)
# Your cluster: xdigix.qhdeatn.mongodb.net
# Database name is the path after the host: /xdigix_db
MONGODB_URI=mongodb+srv://xdigix_admin:<db_password>@xdigix.qhdeatn.mongodb.net/xdigix_db?retryWrites=true&w=majority&appName=Xdigix

# For local MongoDB (creates db on first write)
# MONGODB_URI=mongodb://localhost:27017/xdigix_db

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# CORS - Comma-separated origins (frontend URLs)
# Dashboard runs on 5174; add your network IP (e.g. http://192.168.8.3:5174) for mobile/other devices
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174

# Seed admin (optional - for scripts/seed-admin.js)
ADMIN_EMAIL=admin@xdigix.com
ADMIN_PASSWORD=admin123

# (Firebase deprecated - XDIGIX uses MongoDB only)
