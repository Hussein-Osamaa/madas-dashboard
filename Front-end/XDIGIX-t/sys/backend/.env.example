PORT=4000
NODE_ENV=development

# Required. Use a remote DB (e.g. MongoDB Atlas). Local DB is not used.
# Example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DBNAME?retryWrites=true&w=majority
MONGODB_URI=

JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# S3-compatible storage (optional; local uploads work without)
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=madas-storage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=http://localhost:4000/storage

CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Warehouse / Reports
BASE_URL=http://localhost:4000
REPORTS_DIR=./uploads/reports

# SMTP (for report notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@digix.com

# WhatsApp (Meta Cloud API, optional)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_ID=

# Migration (Firebase to MongoDB) – required when running npm run migrate
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-project-service-account.json
# DRY_RUN=true

# ─── External API (multi-tenant) ───────────────────────────────────────────
# Per-tenant credentials are stored in MongoDB (ExternalTenantConfig). Optional override via JSON:
# EXTERNAL_CREDENTIALS_JSON={"tenantId1":{"apiToken":"...","webhookSecret":"..."}}
# EXTERNAL_CREDENTIALS_JSON=

# Rate limit per tenant (requests per window)
EXTERNAL_API_RATE_LIMIT_PER_TENANT=100
EXTERNAL_API_RATE_LIMIT_WINDOW_MS=60000

# Webhook: reject request if x-webhook-timestamp is older than this (seconds). Replay protection.
EXTERNAL_WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300

# In production, external routes require HTTPS (set to false to allow HTTP for local testing)
# EXTERNAL_API_REQUIRE_HTTPS=false

# ─── Zammit Order Sync ──────────────────────────────────────────────────────
# AES-256-GCM key for encrypting Zammit credentials at rest (required for sync feature).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZAMMIT_ENCRYPTION_KEY=
# Zammit API base URL (default: https://api.zammit.shop)
# ZAMMIT_API_BASE_URL=https://api.zammit.shop
