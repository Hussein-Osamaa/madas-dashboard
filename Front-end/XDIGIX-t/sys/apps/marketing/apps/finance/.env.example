# Use new backend API instead of Firebase
# When set, the Finance app will use the Node.js + MongoDB backend
# Default is Railway production. Override for local backend:
# VITE_API_BACKEND_URL=http://localhost:4000/api
# VITE_API_BACKEND_URL=https://xdigix-os-production.up.railway.app/api

# Optional: default tenant IDs when not in JWT claims
VITE_DEFAULT_WORKSPACE_ID=
VITE_DEFAULT_ORG_ID=
