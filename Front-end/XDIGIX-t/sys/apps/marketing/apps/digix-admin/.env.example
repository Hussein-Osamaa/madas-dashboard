# Use new backend API instead of Firebase
# When set, the Digix Admin app will use the Node.js + MongoDB backend
# Default is Railway production. Override for local backend:
# VITE_API_BACKEND_URL=http://localhost:4000/api
# VITE_API_BACKEND_URL=https://xdigix-os-production.up.railway.app/api

# Client dashboard URL for "Join business for support". Leave unset for same-origin (current host).
# Set when admin and dashboard are on different origins, e.g. https://app.xdigix.com
# VITE_DASHBOARD_URL=https://app.xdigix.com
