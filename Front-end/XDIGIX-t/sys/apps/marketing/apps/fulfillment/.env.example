# Backend API URL. Default (when unset) is Railway production. Override for local backend:
# VITE_API_BACKEND_URL=http://localhost:4000/api
# Production (default in code):
# VITE_API_BACKEND_URL=https://xdigix-os-production.up.railway.app/api

# When backend is on Vercel, warehouse live socket is auto-disabled (no WebSockets on serverless).
# When backend is on Railway, live updates work if VITE_API_BACKEND_URL points to Railway.
# Force-enable: VITE_WAREHOUSE_SOCKET_ENABLED=true  |  Force-disable: VITE_WAREHOUSE_SOCKET_ENABLED=false
# VITE_AUDIT_SOCKET_ENABLED=false
