{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist-unified",
  "framework": null,
  "redirects": [
    { "source": "/setup-password", "destination": "/dashboard/setup-password", "permanent": false },
    { "source": "/reset-password", "destination": "/dashboard/reset-password", "permanent": false }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/dashboard/(.*)", "destination": "/dashboard/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/finance", "destination": "/finance/index.html" },
    { "source": "/finance/(.*)", "destination": "/finance/index.html" },
    { "source": "/warehouse", "destination": "/warehouse/index.html" },
    { "source": "/warehouse/(.*)", "destination": "/warehouse/index.html" },
    { "source": "/track", "destination": "/track/index.html" },
    { "source": "/track/(.*)", "destination": "/track/index.html" },
    { "source": "/ship", "destination": "/ship/index.html" },
    { "source": "/ship/(.*)", "destination": "/ship/index.html" },
    { "source": "/((?!dashboard|admin|finance|warehouse|track|ship|assets).*)", "destination": "/index.html" }
  ]
}
