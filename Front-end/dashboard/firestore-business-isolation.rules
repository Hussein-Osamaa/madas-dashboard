rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to get user's business ID
    function getUserBusinessId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId;
    }
    
    // Helper function to check if user belongs to a business
    function belongsToBusiness(businessId) {
      return getUserBusinessId() == businessId;
    }
    
    // Helper function to check if user is owner of business
    function isBusinessOwner(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }
    
    // Helper function to check if user is staff of business
    function isBusinessStaff(businessId) {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.businessId == businessId;
    }
    
    // Helper function to check if user has permission for specific action
    function hasPermission(permission, action) {
      let userPermissions = get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.permissions;
      return userPermissions[permission] != null && userPermissions[permission].hasAny([action]);
    }

    // Businesses collection - only owners and admins can access
    match /businesses/{businessId} {
      allow read, write: if isAdmin() || isBusinessOwner(businessId);
      allow read: if isBusinessStaff(businessId);
    }

    // Users collection - users can only access their own document
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }

    // Staff collection - business isolation
    match /staff/{staffId} {
      allow read: if request.auth.uid == staffId || isAdmin();
      allow write: if isAdmin();
      allow read: if isBusinessStaff(get(/databases/$(database)/documents/staff/$(staffId)).data.businessId);
    }

    // Business-specific data collections (orders, inventory, customers, etc.)
    match /orders/{orderId} {
      allow read, write: if isAdmin() || 
        (belongsToBusiness(resource.data.businessId) && hasPermission('orders', 'view'));
      allow create: if isAdmin() || 
        (belongsToBusiness(request.resource.data.businessId) && hasPermission('orders', 'create'));
    }

    match /inventory/{itemId} {
      allow read, write: if isAdmin() || 
        (belongsToBusiness(resource.data.businessId) && hasPermission('inventory', 'view'));
      allow create: if isAdmin() || 
        (belongsToBusiness(request.resource.data.businessId) && hasPermission('inventory', 'create'));
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin() || 
        (belongsToBusiness(resource.data.businessId) && hasPermission('customers', 'view'));
      allow create: if isAdmin() || 
        (belongsToBusiness(request.resource.data.businessId) && hasPermission('customers', 'create'));
    }

    match /employees/{employeeId} {
      allow read, write: if isAdmin() || 
        (belongsToBusiness(resource.data.businessId) && hasPermission('employees', 'view'));
      allow create: if isAdmin() || 
        (belongsToBusiness(request.resource.data.businessId) && hasPermission('employees', 'create'));
    }

    match /analytics/{analyticsId} {
      allow read: if isAdmin() || 
        (belongsToBusiness(resource.data.businessId) && hasPermission('analytics', 'view'));
      allow create: if isAdmin() || 
        (belongsToBusiness(request.resource.data.businessId) && hasPermission('analytics', 'create'));
    }

    match /finance/{financeId} {
      allow read, write: if isAdmin() || 
        (belongsToBusiness(resource.data.businessId) && hasPermission('finance', 'view'));
      allow create: if isAdmin() || 
        (belongsToBusiness(request.resource.data.businessId) && hasPermission('finance', 'create'));
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin() || 
        (belongsToBusiness(resource.data.businessId) && hasPermission('settings', 'view'));
      allow create: if isAdmin() || 
        (belongsToBusiness(request.resource.data.businessId) && hasPermission('settings', 'create'));
    }

    // Sites collection for web builder (business-specific)
    match /sites/{siteId} {
      allow read, write: if isAdmin() || 
        (belongsToBusiness(resource.data.businessId) && hasPermission('sites', 'view'));
      allow create: if isAdmin() || 
        (belongsToBusiness(request.resource.data.businessId) && hasPermission('sites', 'create'));
    }

    // Default rule - deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

