rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.approved == true;
    }
    
    // Helper function to check if user is staff member
    function isStaff() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.approved == true;
    }
    
    // Helper function to check if user owns the business
    function isBusinessOwner(businessId) {
      return request.auth != null 
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }
    
    // Staff collection - Admin can read/write all, staff can read their own
    match /staff/{uid} {
      allow read, write: if isAdmin();
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    
    // Businesses collection - Admin can read/write all, owners can read their own
    match /businesses/{businessId} {
      allow read, write: if isAdmin();
      allow read: if isBusinessOwner(businessId);
    }
    
    // Users collection - Admin can read/write all, users can read their own
    match /users/{uid} {
      allow read, write: if isAdmin();
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Todos collection - Users can only access their own todos
    match /todos/{todoId} {
      allow read, write, delete: if request.auth != null 
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null 
        && request.resource.data.uid == request.auth.uid;
    }
    
    // Stats collection - Admin can read/write, staff can read
    match /stats/{statId} {
      allow read, write: if isAdmin();
      allow read: if isStaff();
    }
    
    // Analysis collection - Admin can read/write, staff can read
    match /analysis/{analysisId} {
      allow read, write: if isAdmin();
      allow read: if isStaff();
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
