{
  "project": {
    "name": "MADAS Dashboard",
    "projectId": "madas-store"
  },
  "database": {
    "structure": {
      "topLevelCollection": "businesses",
      "subCollections": [
        "orders",
        "expenses",
        "transactions",
        "payments",
        "staff",
        "scan_log",
        "products",
        "customers",
        "collections",
        "accounts",
        "budgets",
        "reports",
        "tasks"
      ]
    },
    "queries": {
      "common": [
        {
          "collection": "orders",
          "filters": ["createdAt >= start", "createdAt <= end"],
          "ordering": ["createdAt desc"]
        },
        {
          "collection": "transactions",
          "filters": ["createdAt >= start", "createdAt <= end"],
          "ordering": ["createdAt desc"]
        },
        {
          "collection": "products",
          "filters": [],
          "ordering": ["name asc"]
        }
      ]
    }
  },
  "routes": {
    "dashboard": "/",
    "orders": "/orders",
    "finance": {
      "overview": "/finance/overview",
      "transactions": "/finance/transactions",
      "payments": "/finance/payments",
      "expenses": "/finance/expenses",
      "accounts": "/finance/accounts",
      "budgets": "/finance/budgets",
      "reports": "/finance/reports"
    },
    "inventory": {
      "products": "/inventory/products",
      "collections": "/inventory/collections",
      "lowStock": "/inventory/low-stock"
    },
    "customers": "/customers",
    "pos": "/pos",
    "settings": "/settings"
  },
  "authentication": {
    "method": "JWT REST API",
    "endpoint": "/api/auth/login"
  },
  "notes": [
    "Multi-tenant via businessId in MongoDB sub-collections",
    "Load tests use JWT REST API",
    "Businesses collection contains business documents",
    "Each business has sub-collections for orders, transactions, etc."
  ]
}


