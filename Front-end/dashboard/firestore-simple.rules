rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is owner of business
    function isBusinessOwner(businessId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }
    
    // Helper function to check if user is staff of business
    function isBusinessStaff(businessId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.businessId == businessId;
    }

    // Businesses collection
    match /businesses/{businessId} {
      allow read, write: if isAdmin() || isBusinessOwner(businessId);
      allow read: if isBusinessStaff(businessId);
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }

    // Staff collection
    match /staff/{staffId} {
      allow read: if request.auth.uid == staffId || isAdmin();
      allow write: if isAdmin();
    }

    // Products collection - allow anonymous read for demo mode
    match /products/{productId} {
      allow read: if true; // Allow anyone to read products
      allow write: if isAdmin() || isBusinessOwner(resource.data.businessId) || isBusinessStaff(resource.data.businessId);
      allow create: if isAdmin() || isBusinessOwner(request.resource.data.businessId) || isBusinessStaff(request.resource.data.businessId);
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, write: if isAdmin() || isBusinessOwner(resource.data.businessId) || isBusinessStaff(resource.data.businessId);
      allow create: if isAdmin() || isBusinessOwner(request.resource.data.businessId) || isBusinessStaff(request.resource.data.businessId);
    }

    // Inventory collection
    match /inventory/{itemId} {
      allow read, write: if isAdmin() || isBusinessOwner(resource.data.businessId) || isBusinessStaff(resource.data.businessId);
      allow create: if isAdmin() || isBusinessOwner(request.resource.data.businessId) || isBusinessStaff(request.resource.data.businessId);
    }

    // Customers collection
    match /customers/{customerId} {
      allow read, write: if isAdmin() || isBusinessOwner(resource.data.businessId) || isBusinessStaff(resource.data.businessId);
      allow create: if isAdmin() || isBusinessOwner(request.resource.data.businessId) || isBusinessStaff(request.resource.data.businessId);
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read, write: if isAdmin() || isBusinessOwner(resource.data.businessId) || isBusinessStaff(resource.data.businessId);
      allow create: if isAdmin() || isBusinessOwner(request.resource.data.businessId) || isBusinessStaff(request.resource.data.businessId);
    }

    // Analytics collection
    match /analytics/{analyticsId} {
      allow read, write: if isAdmin() || isBusinessOwner(resource.data.businessId) || isBusinessStaff(resource.data.businessId);
      allow create: if isAdmin() || isBusinessOwner(request.resource.data.businessId) || isBusinessStaff(request.resource.data.businessId);
    }

    // Finance collection
    match /finance/{financeId} {
      allow read, write: if isAdmin() || isBusinessOwner(resource.data.businessId) || isBusinessStaff(resource.data.businessId);
      allow create: if isAdmin() || isBusinessOwner(request.resource.data.businessId) || isBusinessStaff(request.resource.data.businessId);
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if isAdmin() || isBusinessOwner(resource.data.businessId) || isBusinessStaff(resource.data.businessId);
      allow create: if isAdmin() || isBusinessOwner(request.resource.data.businessId) || isBusinessStaff(request.resource.data.businessId);
    }

    // Sites collection
    match /sites/{siteId} {
      allow read, write: if isAdmin() || isBusinessOwner(resource.data.businessId) || isBusinessStaff(resource.data.businessId);
      allow create: if isAdmin() || isBusinessOwner(request.resource.data.businessId) || isBusinessStaff(request.resource.data.businessId);
    }

    // Default rule - deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

